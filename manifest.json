{
  "manifest_version": 3,
  "name": "Gemini Live Caption",
  "version": "1.0.0",
  "description": "Real-time AI-powered subtitle translation using Gemini Live API. Replaces Chrome's native Live Caption with Gemini translation.",
  "author": "NaH",
  "homepage_url": "https://github.com/SodiumHydride/gemini-live-caption",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": ["tabCapture", "offscreen", "storage", "tabs", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Gemini Live Caption",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "toggle-capture": {
      "suggested_key": { "default": "Alt+C" },
      "description": "Toggle live caption"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["pip.html", "pip.css", "pip.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
